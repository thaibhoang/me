<%= content_tag tag, class: wrapper_classes do %>
  <div class="min-w-0 flex-1">
    <% if title %>
      <div class="font-semibold tracking-tight text-slate-100 <%= title_classes %>"><%= title %></div>
    <% end %>
    <% if body %>
      <div class="mt-2 text-sm leading-relaxed text-slate-300 <%= body_classes %>"><%= body %></div>
    <% end %>
    <% if footer %>
      <div class="mt-4"><%= footer %></div>
    <% end %>
  </div>
  <% if meta %>
    <div class="mt-1 shrink-0 text-xs uppercase tracking-wide text-slate-500 <%= meta_classes %>"><%= meta %></div>
  <% end %>
<% end %>
